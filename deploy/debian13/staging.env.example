# hermes.sh init generates this root-readable file outside the repository.
HERMES_ROOT=/opt/hermes
HERMES_DATA_DIR=/var/lib/hermes
HERMES_WORK_DIR=/var/cache/hermes
HERMES_INSTANCE=hermes-staging
HERMES_DOMAIN=flotta-teszt.example.hu
HERMES_ACME_EMAIL=uzemelteto@example.hu
HERMES_RELEASE=initial
HERMES_API_IMAGE=hermes-api:initial
HERMES_FRONTEND_IMAGE=hermes-frontend:initial
HERMES_POSTGRES_IMAGE=postgres:18-alpine

# Optional single-tenant Microsoft Entra ID sign-in. See backend/README.md.
HERMES_ENTRA_ENABLED=false
HERMES_ENTRA_TENANT_ID=
HERMES_ENTRA_CLIENT_ID=
HERMES_ENTRA_CLIENT_SECRET=
HERMES_CADDY_IMAGE=caddy:2.11.7-alpine
HERMES_EDGE_SUBNET=172.30.90.0/24
HERMES_EDGE_DYNAMIC_RANGE=172.30.90.128/25
HERMES_PROXY_IP=172.30.90.2
POSTGRES_ADMIN_PASSWORD=GENERATE_WITH_INIT
POSTGRES_MIGRATOR_PASSWORD=GENERATE_WITH_INIT
POSTGRES_APP_PASSWORD=GENERATE_WITH_INIT
RESTIC_REPOSITORY=/mnt/offsite-backups/hermes
RESTIC_PASSWORD_FILE=/etc/hermes/restic-password
# SFTP example: sftp:backup@backup.example.hu:/srv/backups/hermes
# S3 example: s3:https://s3.example.hu/bucket/hermes
# Add AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY for an S3 repository.
